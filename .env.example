# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/recherche/.env and restrict permissions:
#   chmod 600 "${XDG_CONFIG_HOME:-$HOME/.config}/recherche/.env"
#
# Loaded at startup (except `recherche demo`) so background services such as
# `brew services` receive credentials without editing service definitions.
# Variables already set in your shell environment take precedence.
# Keep real secrets out of this repository.

# OpenRouter API key (or whichever variable `llm.api_key_env` names).
# OPENROUTER_API_KEY=sk-or-...

# Optional overrides for background services:
# RECHERCHE_LOG=recherche=info
# RECHERCHE_DATA_DIR=/absolute/path/to/data
# CLAUDE_CONFIG_DIR=/absolute/path/to/claude
# CODEX_HOME=/absolute/path/to/codex
