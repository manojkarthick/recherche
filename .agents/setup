#!/usr/bin/env bash
set -euo pipefail

# Amp runs this on fresh orbs to install Rust, native build dependencies,
# and a checksum-verified ONNX Runtime CPU shared library. Afterwards,
# cargo test (or cargo test --locked) needs no model downloads or API keys.
# All build overrides stay orb-local; macOS builds are unchanged.

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# This is an orb-only environment; do not change macOS's Cargo dependencies.
if [[ "$(uname -s)-$(uname -m)" != Linux-x86_64 ]]; then
    echo 'Orb setup requires x86_64 Linux.' >&2
    exit 1
fi

echo 'Checking system build dependencies'
packages=()
for package in build-essential pkg-config libssl-dev ca-certificates curl libstdc++6; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
        packages+=("$package")
    fi
done
if ((${#packages[@]})); then
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
fi

rust_version=1.99.1
echo "Checking Rust $rust_version"
if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    installer=$(mktemp)
    curl --proto '=https' --tlsv1.2 -fsSL --retry 3 https://sh.rustup.rs -o "$installer"
    sh "$installer" -y --profile minimal --default-toolchain "$rust_version"
    rm -f "$installer"
fi
export PATH="$HOME/.cargo/bin:$PATH"
if ! rustup toolchain list | grep -q "^${rust_version}-"; then
    rustup toolchain install "$rust_version" --profile minimal
fi
rustup default "$rust_version"

# ort-sys 2.0.0-rc.15 (Cargo.lock) uses ONNX Runtime API 31. Its default
# static download needs newer glibc/libstdc++ symbols than Debian 12 has.
# Microsoft's CPU shared build supports Debian 12 without upgrading glibc.
# If the locked API changes, update this version and archive checksum together.
ort_version=1.31.0
ort_root="/opt/recherche/onnxruntime-linux-x64-$ort_version"
echo "Checking ONNX Runtime $ort_version"
if [[ ! -f "$ort_root/lib/libonnxruntime.so.$ort_version" ]]; then
    download=$(mktemp -d)
    trap 'rm -rf "$download"' EXIT
    curl -fL --retry 3 \
        "https://github.com/microsoft/onnxruntime/releases/download/v$ort_version/onnxruntime-linux-x64-$ort_version.tgz" \
        -o "$download/runtime.tgz"
    echo "cc5c72baf5ae5c8238a6841f0897227be2d02826b9cf98eaf02fdefaeeb03a57  $download/runtime.tgz" | sha256sum -c -
    tar -xzf "$download/runtime.tgz" -C "$download"
    sudo mkdir -p /opt/recherche
    sudo mv "$download/onnxruntime-linux-x64-$ort_version" "$ort_root"
    rm -rf "$download"
    trap - EXIT
fi
echo "$ort_root/lib" | sudo tee /etc/ld.so.conf.d/recherche-onnxruntime.conf >/dev/null
sudo ldconfig

# Cargo reads this in every shell, not just the shell that ran setup. Keep
# machine-specific paths and small-orb memory limits out of the repository.
# Two compilation jobs without debug symbols fit small orbs; ldconfig above
# makes the shared library available when running built executables directly.
mkdir -p .cargo
marker='# Generated by recherche .agents/setup'
if [[ -f .cargo/config.toml ]] && ! grep -Fxq "$marker" .cargo/config.toml; then
    echo 'Refusing to overwrite existing .cargo/config.toml.' >&2
    exit 1
fi
cat > .cargo/config.toml <<EOF
$marker
[build]
jobs = 2

[profile.dev]
debug = 0

[env]
ORT_LIB_PATH = "$ort_root/lib"
ORT_PREFER_DYNAMIC_LINK = "1"
EOF
exclude=$(git rev-parse --git-path info/exclude)
if ! grep -Fxq '/.cargo/config.toml' "$exclude"; then
    printf '\n/.cargo/config.toml\n' >> "$exclude"
fi

echo 'Fetching locked Rust dependencies'
cargo fetch --locked
echo 'Orb setup complete. Run cargo test.'
